[
  {
    "name": "FFmpeg H.264 高画質",
    "encoder": "ffmpeg",
    "args": [
      "-map",
      "0:v:0",
      "-map",
      "0:a:0?",
      "-vf",
      "yadif=deint=interlaced",
      "-c:v",
      "libx264",
      "-preset",
      "fast",
      "-crf",
      "20",
      "-pix_fmt",
      "yuv420p",
      "-c:a",
      "aac",
      "-b:a",
      "160k",
      "-movflags",
      "+faststart"
    ]
  },
  {
    "name": "FFmpeg H.264 省容量",
    "encoder": "ffmpeg",
    "args": [
      "-map",
      "0:v:0",
      "-map",
      "0:a:0?",
      "-vf",
      "yadif=deint=interlaced,scale=-2:'min(720,ih)'",
      "-c:v",
      "libx264",
      "-preset",
      "fast",
      "-crf",
      "26",
      "-pix_fmt",
      "yuv420p",
      "-c:a",
      "aac",
      "-b:a",
      "160k",
      "-movflags",
      "+faststart"
    ]
  },
  {
    "name": "機器互換 MP4 H.264 High 4.2（1080p30・FFmpeg）",
    "encoder": "ffmpeg",
    "args": [
      "-map",
      "0:v:0",
      "-map",
      "0:a:0?",
      "-vf",
      "yadif=mode=send_frame:deint=interlaced,fps=30,scale=1920:1080:force_original_aspect_ratio=decrease:force_divisible_by=2:reset_sar=1",
      "-c:v",
      "libx264",
      "-preset",
      "fast",
      "-profile:v",
      "high",
      "-level:v",
      "4.2",
      "-pix_fmt",
      "yuv420p",
      "-crf",
      "20",
      "-maxrate",
      "36M",
      "-bufsize",
      "36M",
      "-c:a",
      "aac",
      "-profile:a",
      "aac_low",
      "-ac",
      "2",
      "-ar",
      "48000",
      "-b:a",
      "192k",
      "-movflags",
      "+faststart"
    ]
  }
]
